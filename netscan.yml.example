# netscan configuration. Copy to netscan.yml and edit.
#
# netscan NEVER blocks or changes a device — it only records and alerts.
# There is no enforce flag here because there is no enforcement path.

# Networks to sweep. An ARP sweep is layer 2: it only sees networks this box
# has an interface on. Adding a network here without an interface on it
# returns zero hosts SILENTLY, which is worse than not scanning it.
# If unset, netscan uses `estate.lan` from warden.yml.
#
# IoT VLANs: if your IoT devices sit on a separate VLAN, this box needs an
# interface (or a tagged sub-interface) on it before netscan can see them.
# Check where the devices ACTUALLY are first — a VLAN that exists on paper but
# holds nothing is common, and putting a management box on both sides of the
# boundary weakens the segmentation it exists for.
networks:
  - 192.168.1.0/24

# TCP connect scan of discovered hosts. Slower than discovery — this is why
# the port sweep runs daily and the discovery sweep runs every 15 minutes.
port_scan: true
top_ports: 200

# Hosts whose absence from a sweep is worth waking up for. Deliberately short:
# phones, laptops and the printer come and go, and alerting on that teaches
# you to ignore the channel. These are infrastructure that should always answer.
critical:
  - 192.168.1.2     # hypervisor
  - 192.168.1.5     # NAS
  - 192.168.1.10    # the box warden runs on

alert: true

# Hours from the very first sweep during which a newly-seen device is adopted
# silently, with no NEW_DEVICE alert.
#
# ⚠️ Do not set this to 0. An ARP sweep only sees devices that are awake:
# measured on this LAN, two sweeps twelve minutes apart returned 48 then 46
# devices, and six of the "new" ones were WiZ bulbs, a Nest and the TV that had
# simply been asleep. Without a learning window those become recurring false
# alarms and the channel stops being worth reading.
learn_hours: 48
