# warden configuration. `warden-setup init` writes this for you; or copy to warden.yml and edit.
# Every section except the first is optional — a feature with no config simply doesn't run.

# ── detection ───────────────────────────────────────────────────────────────
# enforce: false == DETECT ONLY. warden records what it *would* ban and changes
# nothing. Flip to true only once the proposed bans have looked correct for a
# few days -- and read KNOWN-ISSUES.md first, because the enforcement path has
# caveats. A tool that can lock you out of your own estate does not get to do
# that unsupervised.
enforce: false

# Sum of scores, per IP, inside window_minutes, needed to propose a ban.
# For reference: /etc/passwd probe = 8, vite @fs = 7, sqli = 8, a bare 404 = 1.
ban_threshold: 12
window_minutes: 60
max_bans_per_run: 3

# /24 roll-up: catches an attacker spread thin across a subnet, below the
# per-IP threshold. Stricter than the per-IP rule on purpose -- a /24 block is
# a blunt instrument, so it needs a higher total AND several distinct addresses.
subnet_threshold: 20
subnet_min_ips: 3
ban_hours: 24

# Never ban these, on top of the built-in RFC1918 + Cloudflare edge ranges.
# Put YOUR OWN public IPs here so a bad day never edge-bans you.
allow:
  - 203.0.113.7
  - 198.51.100.0/24

# ── who you are ─────────────────────────────────────────────────────────────
estate:
  name: home
  domain: example.com             # your public domain (Cloudflare features, edge hosts)
  lan: [192.168.1.0/24]           # what counts as "inside"
  timezone: Europe/London         # patch night window is in this zone
  self_target: ""                 # target id of the box warden runs on, e.g. ct:100 — never patched blind

# ── where the logs are ──────────────────────────────────────────────────────
# ssh: user@host, or "local". container: read inside that Docker container.
sources:
  npm:         {ssh: admin@192.168.1.5, container: npmplus, log: /data/nginx/logs/access.log}
  authelia:    {ssh: admin@192.168.1.5, container: authelia, log: /config/authelia.log}
  cloudflared: {ssh: admin@192.168.1.5, container: cloudflared}
  crowdsec:    {ssh: root@192.168.1.6}            # optional: alerts from a CrowdSec LAPI host
  # caddy:     {ssh: admin@192.168.1.5, container: caddy, log: /var/log/caddy/access.log}      # JSON access log
  # traefik:   {ssh: admin@192.168.1.5, container: traefik, log: /var/log/traefik/access.log}  # CLF access log
  # authentik: {ssh: admin@192.168.1.5, container: authentik-server}                            # stdout, not a file

# ── machines (vulnerability scans, patch proposals, integrity, hardening) ──
# Reached over SSH with a key; nothing is installed on them. See wlib/hosts.py.
hosts:
  - {name: pve1, kind: proxmox, ssh: root@192.168.1.2, discover: true, docker_cts: [104], patch: true}
  - {name: nas,  kind: docker,  ssh: admin@192.168.1.5, firmware: zimaos}
  - {name: llm,  kind: linux,   ssh: me@192.168.1.7, sudo_secret: LLM_SUDO, patch: true}
  - {name: this-box, kind: local}
roles:                              # shown to whoever approves a patch
  "ct:100": "reverse proxy + this dashboard — a restart drops every LAN page for a minute"
core: ["ct:100"]                    # restarts of these wait for the night window

patch:
  night: "02:30"
  expire_hours: 24                  # an unanswered plan expires; nothing changes
  snapshot_keep_days: 7
  # auto_after_days: 5              # 0 (default) = off. Set it to auto-apply unanswered NON-urgent plans in the night
  #                                 # window after this many days (one quiet Discord line, ❌ to stop). A plan that fixes
  #                                 # a known-exploited (CISA KEV) or critical CVE is "urgent": it still pings for your ✅/⚡/❌.
  # optional: run this around every patch job, so your monitoring can hold its fire:
  #   <cmd> start|end <target> <vmid> <node> <name>
  # A failure is logged and the patch continues. The command is yours, so it stays out of this repo.
  # window_hook: /opt/warden/hooks/patch_window.py

# vulnerability scanning needs no settings: advisories come from api.osv.dev (+ Alpine secdb), exploit data from
# CISA KEV and FIRST EPSS. Optional AI "fix first" briefing (vulnbrief.py, any OpenAI-compatible endpoint):
vuln:
  brief: {url: https://openrouter.ai/api/v1, models: [deepseek/deepseek-v4-flash-0731], key_secret: OPENROUTER_API_KEY}
  # the same block powers the approval-queue recommendations (wlib/recommend.py). Optional
  # recommend_model: a cheaper model for that job; it recommends, it never decides.

# ── alerts and approvals ────────────────────────────────────────────────────
# discord can read ✅/❌ reactions back; webhook/ntfy/none approve in the dashboard (Settings).
notify:
  backend: discord                  # discord | webhook | ntfy | none
  channel: "000000000000000000"
  owner_id: "000000000000000000"    # the only user whose reactions count
  token_secret: DISCORD_BOT_TOKEN
  # webhook_secret: ALERT_WEBHOOK
  # ntfy_url: https://ntfy.sh/your-topic

# ── secrets: names only, never values ───────────────────────────────────────
# Looked up in: environment → data/secrets.env (mode 600, `warden-setup secret NAME`) → backend.
secrets:
  backend: env                      # env | infisical | command
  # map: {CF_API_TOKEN: "/Cloudflare:WAF token"}

# ── Cloudflare (optional) ───────────────────────────────────────────────────
cloudflare:
  zone_id: ""
  account_id: ""
  token_secret: CF_API_TOKEN        # Zone WAF Edit, Zone Settings Read, Analytics Read, DNS Read
  sso_portal: auth.example.com
  edge_hosts: [auth, photos]        # hostnames the edge-sentry Worker sits in front of
  sso_exempt:                       # public names deliberately NOT behind SSO, and why
    auth.example.com: "is the SSO portal itself"

# ── network IDS and router (optional) ───────────────────────────────────────
ids:
  suricata_host: ""                 # root@host, host, or local — reads Suricata's eve.json
  eve_path: /var/log/suricata/eve.json
router:
  ssh: ""                           # read-only SSH to an OpenWrt-style router: DNS log + conntrack
  key: ""

# ── console, REST API and MCP ───────────────────────────────────────────────
ui:
  host: 127.0.0.1                   # keep it on localhost and put HTTPS (a reverse proxy) in front
  port: 8792
  auth: local                       # local = warden's own sign-in (users, roles, 2FA) — make the first admin with
                                    #   warden-setup user add NAME --role admin
                                    # proxy = your reverse proxy / SSO signs people in (Authelia, Authentik…)
                                    # basic = the old single shared password (basic_user + WARDEN_UI_PASSWORD secret)
  session_hours: 12                 # a sign-in lasts at most this long …
  idle_minutes: 120                 # … and ends sooner if the console sits unused
  cookie_secure: auto               # auto = Secure cookie when the proxy says X-Forwarded-Proto: https
  real_ip_header: ""                # e.g. CF-Connecting-IP behind Cloudflare; default = last X-Forwarded-For hop
  trust_proxy_user_header: Remote-User   # auth: proxy only
  trust_proxy_insecure: false            # auth: proxy only — allow a non-loopback bind (the proxy MUST overwrite Remote-User and the port MUST be firewalled; otherwise warden refuses to start)
  basic_user: ""                    # auth: basic only
api:
  enabled: true
  public_url: ""                    # how agents reach warden, e.g. https://warden.example.com
dashboard:
  widgets: null                     # null = default; the Customise button saves your own

# optional: a "Host health" card from Beszel (wlib/hosthealth.py). warden only reads Beszel's verdict.
# beszel:
#   enabled: true
#   snapshot: /var/lib/beszel-snapshot/hosts.json   # A) on the hub box: tools/beszel-snapshot.py on a 1-min timer
#   # url: http://beszel.lan:8090                   # B) or the hub API as a user with Beszel's read-only role
#   # user: warden@example.com
#   # password_secret: BESZEL_PASSWORD
#   link: http://beszel.lan:8090                    # "Open Beszel" on the card
#   stale_s: 300
#   ignore_hosts: []                                # still registered in Beszel but gone on purpose
#   ignore_alerts: {}                               # e.g. {nas: [Disk]} for a read-only root that always reads 100%

# optional: which containers the internet reaches (wlib/exposure.py) — reads your reverse proxy's routes
# exposure:
#   npm: {url: "https://192.168.1.10:81", user_secret: NPM_USER, pass_secret: NPM_PASSWORD, verify_tls: false}
#   extra: [{host: vpn.example.com, upstream: ["192.168.1.20:443"]}]   # hand-written routes the API can't show

# ── Hermes agent activity ────────────────────────────────────────────────────
# agents.py attributes each outbound connection on an agent host to the AGENT that made it, flags any reaching a
# known-bad host, and records what each agent can access. Detect-only, read-only. The box warden runs on is watched
# by default. It is not Hermes-specific — name any agent you run.
agents:
  include_local: true            # also watch the box warden itself runs on (where most agents run); false to skip it
  learn_hours: 48                # a destination first seen within this long of an agent's first sighting is "learning"
  hermes_profile: sec            # which Hermes profile writes the advisory line on a review card (set to "" to skip)
  patterns:                      # name your own agents — checked BEFORE the built-ins (hermes/opencode/ollama/…),
    []                           #   so you can override or extend. Each: {pattern: <regex on the command line>,
                                 #   name: <label>}. $1..$9 in name expand to regex capture groups. Examples:
                                 #   - {pattern: '\bmuse\b', name: 'muse'}
                                 #   - {pattern: 'mybot --role (\w+)', name: 'mybot:$1'}
  secret_files:                  # sensitive files whose readability by each agent warden should report (absolute
    []                           #   paths; warden's own warden.yml and DB are always included). e.g. /root/.env
  ignore:                        # processes NOT tracked (substring, or /regex/ against the command line). The defaults
    []                           #   already drop Claude Code, ssh/sshd and system daemons; add your own here.
# Mark any OTHER host that runs agents with `agents: true` in its hosts: entry above.

# ── GitHub activity (optional) ──────────────────────────────────────────────
# github.py records pushes, commits, pull requests and reviews for the repos you
# name, and posts new activity to Discord. It reads only; it never creates,
# pushes, merges or approves. Off until github.owner is set.
github:
  owner: ""                         # the account/org whose repos to watch, e.g. casareanderson
  repos: [warden, sieve, ephor]     # repos under that owner (defaults to the "warden family")
  token_secret: GITHUB_TOKEN        # classic PAT, or a fine-grained token with Contents+PRs:Read
  notify: true                      # post new pushes/commits/PRs/reviews to Discord
  channel: ""                       # optional: another Discord channel id for GitHub activity ("" = the alert channel)

# ── AI code review (mentor) ──────────────────────────────────────────────────
# review.py runs mentor over PRs that opened or got new commits and posts the verdict to Discord. Read-only: it never
# edits, commits, pushes or merges. Uses the endpoint below; without `review:` it falls back to `vuln.brief`.
# review:
#   url: https://openrouter.ai/api/v1
#   model: qwen/qwen3.7-flash
#   key_secret: OPENROUTER_API_KEY

# ── shell-command audit (optional, on with hosts) ────────────────────────────
# shellhistory.py reads each box's bash/zsh history (root + every login user)
# and flags suspicious commands — privilege escalation, destructive, force-push,
# pipe-to-shell, secrets typed into history. Only flagged commands reach Discord,
# with any `KEY=value` redacted. On by default wherever hosts are declared.
# shell: {}

# ── app-layer web vulnerability scan ─────────────────────────────────────────
# webscan.py scans your OWN public sites (the attack-surface names warden already knows + any extra you name). Built-in
# checks always run (no install): missing security headers, exposed .env/.git/config/aws-credentials, and exposed admin
# panels. nuclei (optional) adds the full ProjectDiscovery template library if it's installed. Detect-only: an app bug is
# fixed in code, not patched, so it reports and never "fixes".
# webscan:
#   nuclei: ""                 # path to nuclei; "" = find it on PATH (optional — built-in checks don't need it)
#   targets: []                # extra URLs to scan on top of your public names
#   auto_targets: true         # also scan the public names in warden's attack-surface snapshot
#   severity: medium,high,critical
#   rate_limit: 10             # requests/second — be gentle with your own sites


